# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/code-synce

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (OTP) - Gmail App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Twilio (Phone OTP)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Google AI (AI Assistant)
GOOGLE_API_KEY=your-google-gemini-api-key

# React Bits Pro (AI Chat 1 block) - required to authenticate the shadcn
# registry (https://pro.reactbits.dev/docs/installation). Add this same key
# to your local .env.local before running `npx shadcn add`.
REACTBITS_LICENSE_KEY=your-reactbits-pro-license-key

# Socket server (Railway) - used by the editor for realtime collaboration.
# NEXT_PUBLIC_* variables are inlined at BUILD time, so this must be set
# in your host's build environment (Vercel) and requires a redeploy after changes.
# Example: https://codesynce-socket.up.railway.app
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
